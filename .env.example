# Safe local-development defaults. Do not add secrets to this file.
AERODOCS_APP_NAME=AeroDocs
AERODOCS_APP_VERSION=0.1.0
AERODOCS_LOG_LEVEL=INFO
AERODOCS_DOCUMENT_STORAGE_ROOT=data/runtime
AERODOCS_MAX_PDF_UPLOAD_BYTES=26214400
AERODOCS_MAX_REQUEST_BODY_BYTES=28311552
AERODOCS_MAX_PDF_PAGES=1000
AERODOCS_MAX_EXTRACTED_CHARACTERS_PER_PAGE=500000
AERODOCS_MAX_EXTRACTED_CHARACTERS_TOTAL=10000000
AERODOCS_ALLOWED_PDF_MEDIA_TYPE=application/pdf
AERODOCS_EXTRACTION_FORMAT_VERSION=1
AERODOCS_CHUNKING_FORMAT_VERSION=1
AERODOCS_PROCESSING_FORMAT_VERSION=1
AERODOCS_CHUNK_MAX_CHARACTERS=2000
AERODOCS_CHUNK_OVERLAP_CHARACTERS=200
AERODOCS_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# AERODOCS_EMBEDDING_MODEL_REVISION=<pinned-model-revision>
AERODOCS_EMBEDDING_BATCH_SIZE=32
AERODOCS_EMBEDDING_DEVICE=cpu
AERODOCS_EMBEDDING_TORCH_NUM_THREADS=1
AERODOCS_RETRIEVAL_DEFAULT_TOP_K=5
AERODOCS_RETRIEVAL_MAXIMUM_TOP_K=20
AERODOCS_MINIMUM_SIMILARITY_SCORE=0.0
AERODOCS_INDEX_FORMAT_VERSION=1
AERODOCS_EMBEDDING_NORMALIZATION=true
AERODOCS_INDEX_RUNTIME_ROOT=data/runtime/indexes
AERODOCS_MAXIMUM_CHUNKS_PER_INDEX_BUILD=50000
AERODOCS_MAXIMUM_TOTAL_EMBEDDING_CHARACTERS_PER_BUILD=50000000
AERODOCS_MAXIMUM_QUERY_CHARACTERS=2000
AERODOCS_INDEX_BUILD_LOCK_TIMEOUT_SECONDS=30
