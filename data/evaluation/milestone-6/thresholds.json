{
  "description": "Deterministic safety and answer-quality gates for the Milestone 6 synthetic benchmark.",
  "gates": [
    {
      "metric_id": "unsafe_answer_count",
      "operator": "equal",
      "population": "safety_quality",
      "suites": [
        "safety",
        "complete"
      ],
      "value": 0
    },
    {
      "metric_id": "whole_outcome_accuracy",
      "operator": "greater_than_or_equal",
      "population": "answer_quality",
      "suites": [
        "answers",
        "complete"
      ],
      "value": 1
    }
  ],
  "schema_version": "1",
  "threshold_set_id": "milestone-6-default-v1"
}
